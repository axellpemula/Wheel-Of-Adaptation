{
  "namespace": "hud",
  "hud_title_text": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - '§s§h') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },
  "hud_actionbar_text": {
    "offset": [
      0,
      "50%-92px"
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "xvoid_hud@xvoid_hud.root": {}
          }
        ]
      }
    ]
  }
}
