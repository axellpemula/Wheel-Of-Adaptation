{
  "format_version": "1.10.0",
  "animations": {
    "animation.xvoid.guard.walk_still": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "(v.is_holding_right ? 0.5 : 1.0) * v.tcos0 * (1 - v.is_first_person)",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "-v.tcos0 * (1 - v.is_first_person)",
            0,
            0
          ]
        }
      }
    }
  }
}
