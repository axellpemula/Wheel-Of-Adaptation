{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:adapt_sparks_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 75
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.95)"
      },
      "minecraft:particle_initial_speed": "math.random(5.0, 10.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.2,
        "linear_acceleration": [
          0,
          -4.0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.34 * (1 - v.particle_age / v.particle_lifetime)) * 1.2",
          "(0.035 * (1 - 0.5 * v.particle_age / v.particle_lifetime)) * 1.2"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.33": [
              1.0,
              0.93,
              0.62,
              1.0
            ],
            "0.67": [
              1.0,
              0.8,
              0.3,
              1.0
            ],
            "1.00": [
              1.0,
              0.7,
              0.2,
              0.0
            ]
          }
        }
      }
    }
  }
}
