{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:positive_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 16,
        "max_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.04,
          0.55,
          0.04
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.7)"
      },
      "minecraft:particle_initial_speed": "math.random(0.02, 0.12)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.35,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 * (1 - v.particle_age / v.particle_lifetime * 0.8)",
          "0.07 * (1 - v.particle_age / v.particle_lifetime * 0.8)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              0.92,
              0.96,
              1.0,
              1.0
            ],
            "1.00": [
              1.0,
              1.0,
              1.0,
              0.0
            ]
          }
        }
      }
    }
  }
}