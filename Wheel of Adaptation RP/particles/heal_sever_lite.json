{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:heal_sever_lite",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.45,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.85)"
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -3.5,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.11 * (1 - v.particle_age / v.particle_lifetime * 0.7)",
          "0.11 * (1 - v.particle_age / v.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              0.4,
              0.35,
              0.95
            ],
            "0.45": [
              0.75,
              0.1,
              0.15,
              0.85
            ],
            "1.00": [
              0.3,
              0.0,
              0.05,
              0.0
            ]
          }
        }
      }
    }
  }
}
