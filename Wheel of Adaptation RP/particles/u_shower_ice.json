{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_shower_ice",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 22
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.7)"
      },
      "minecraft:particle_initial_speed": "math.random(4.0, 9.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -7.0,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.45 * (1 - v.particle_age / v.particle_lifetime)",
          "0.045 * (1 - 0.5 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              0.92,
              0.96,
              1.0,
              1.0
            ],
            "1.00": [
              0.92,
              0.96,
              1.0,
              0.0
            ]
          }
        }
      }
    }
  }
}
