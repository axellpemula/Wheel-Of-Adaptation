{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:blink_out_ultra",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 31
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.45,
          0.9,
          0.45
        ],
        "direction": [
          "v.kick_dir.x",
          "v.kick_dir.y",
          "v.kick_dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.25)"
      },
      "minecraft:particle_initial_speed": "math.random(10.0, 16.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.6 + v.particle_age / v.particle_lifetime * 1.4) * 1.2",
          "(0.08 * (1 - v.particle_age / v.particle_lifetime)) * 1.2"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.06,
              0.05,
              0.1,
              0.9
            ],
            "0.50": [
              0.2,
              0.18,
              0.3,
              0.6
            ],
            "1.00": [
              0.38,
              0.36,
              0.5,
              0.0
            ]
          }
        }
      }
    }
  }
}
