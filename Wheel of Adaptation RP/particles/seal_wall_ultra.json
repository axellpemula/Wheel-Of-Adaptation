{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:seal_wall_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/adapt_ray"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 110,
        "max_particles": 330
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.0
      },
      "minecraft:emitter_shape_disc": {
        "radius": 32,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.6, 2.4)"
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 2.2)",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 + 0.3 * v.particle_random_1",
          "(3.0 + 4.0 * v.particle_random_1) * math.sin(180 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              0.8,
              0.3,
              0.0
            ],
            "0.25": [
              1.0,
              0.93,
              0.62,
              0.7
            ],
            "0.75": [
              1.0,
              0.8,
              0.3,
              0.6
            ],
            "1.00": [
              1.0,
              0.7,
              0.2,
              0.0
            ]
          }
        }
      }
    }
  }
}
