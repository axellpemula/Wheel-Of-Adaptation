{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:adapt_fire_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fb_flame"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 120.0,
        "max_particles": 224
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.8
      },
      "minecraft:emitter_shape_disc": {
        "radius": 2.4,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9)"
      },
      "minecraft:particle_initial_speed": "math.random(1.0, 2.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "((0.4 + 0.25 * v.particle_random_1) * (1 - 0.45 * v.particle_age / v.particle_lifetime)) * 1.2",
          "((0.48 + 0.3 * v.particle_random_1) * (1 - 0.45 * v.particle_age / v.particle_lifetime)) * 1.2"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 800,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              80,
              96
            ],
            "step_UV": [
              80,
              0
            ],
            "max_frame": 10,
            "frames_per_second": 14,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              0.0
            ],
            "0.12": [
              1.0,
              0.93,
              0.62,
              1.0
            ],
            "0.60": [
              1.0,
              0.8,
              0.3,
              0.9
            ],
            "1.00": [
              1.0,
              0.7,
              0.2,
              0.0
            ]
          }
        }
      }
    }
  }
}
