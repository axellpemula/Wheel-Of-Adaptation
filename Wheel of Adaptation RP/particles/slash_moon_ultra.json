{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:slash_moon_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fb_moon"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.26
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.5 + 0.4 * v.particle_age / v.particle_lifetime) * 1.4",
          "(0.62 + 0.16 * v.particle_age / v.particle_lifetime) * 1.4"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1600,
          "texture_height": 160,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              160,
              160
            ],
            "step_UV": [
              160,
              0
            ],
            "max_frame": 10,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              0.9
            ],
            "0.50": [
              0.92,
              0.96,
              1.0,
              0.85
            ],
            "1.00": [
              0.65,
              0.8,
              1.0,
              0.5
            ]
          }
        }
      }
    }
  }
}
