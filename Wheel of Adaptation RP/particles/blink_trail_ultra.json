{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:blink_trail_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.25,
          0.6,
          0.25
        ],
        "direction": [
          "v.kick_dir.x",
          "v.kick_dir.y",
          "v.kick_dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.08, 0.15)"
      },
      "minecraft:particle_initial_speed": "math.random(20.0, 30.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 8.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.6 + v.particle_age / v.particle_lifetime * 2.0) * 1.2",
          "(0.06 * (1 - v.particle_age / v.particle_lifetime)) * 1.2"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              0.92,
              0.96,
              1.0,
              1.0
            ],
            "1.00": [
              0.55,
              0.55,
              0.8,
              0.0
            ]
          }
        }
      }
    }
  }
}
