{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:adapt_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/adapt_ray"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.95,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(3.3, 3.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.09 + 0.12 * v.particle_random_1) * (1 - 0.5 * v.particle_age / v.particle_lifetime)",
          "0.6 + 3.2 * v.particle_age"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              0.0
            ],
            "0.15": [
              1.0,
              0.93,
              0.62,
              0.85
            ],
            "0.60": [
              1.0,
              0.8,
              0.3,
              0.55
            ],
            "1.00": [
              1.0,
              0.7,
              0.2,
              0.0
            ]
          }
        }
      }
    }
  }
}
