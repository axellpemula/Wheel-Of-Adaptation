{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:reflect_bolt_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.ward_dir.x",
          "v.ward_dir.y",
          "v.ward_dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.12, 0.2)"
      },
      "minecraft:particle_initial_speed": "math.random(20.0, 30.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 8.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.2 + v.particle_age / v.particle_lifetime * 1.6) * 1.3",
          "(0.07 * (1 - v.particle_age / v.particle_lifetime)) * 1.3"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.33": [
              1.0,
              0.93,
              0.62,
              1.0
            ],
            "0.67": [
              1.0,
              0.8,
              0.3,
              1.0
            ],
            "1.00": [
              1.0,
              0.7,
              0.2,
              0.0
            ]
          }
        }
      }
    }
  }
}
