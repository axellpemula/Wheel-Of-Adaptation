{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:seal_bolt_core",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/adapt_ray"
      }
    },
