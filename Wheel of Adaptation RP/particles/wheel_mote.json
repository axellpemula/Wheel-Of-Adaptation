{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:wheel_mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.emitter_age > 1.25 && v.emitter_age < 3.5 ? 15 : 0",
        "max_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 3.8
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.6,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.45)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.3,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 * (1 - v.particle_age / v.particle_lifetime)",
          "0.07 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              0.88,
              0.4,
              1.0
            ],
            "0.60": [
              1.0,
              0.7,
              0.2,
              0.9
            ],
            "1.00": [
              1.0,
              0.55,
              0.1,
              0.0
            ]
          }
        }
      }
    }
  }
}
