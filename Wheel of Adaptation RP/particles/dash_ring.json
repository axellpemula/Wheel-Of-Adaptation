{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:dash_ring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/fx_puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.3,
        "plane_normal": "y",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.5)"
      },
      "minecraft:particle_initial_speed": "math.random(3.0, 5.0)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-90, 90)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 6.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.14 + 0.2 * v.particle_age / v.particle_lifetime",
          "0.14 + 0.2 * v.particle_age / v.particle_lifetime"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.9,
              0.9,
              0.95,
              0.55
            ],
            "1.00": [
              0.75,
              0.75,
              0.8,
              0.0
            ]
          }
        }
      }
    }
  }
}
