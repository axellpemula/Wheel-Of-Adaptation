{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:slash_spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.2, 0.4)"
      },
      "minecraft:particle_initial_speed": "math.random(1.0, 2.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - v.particle_age / v.particle_lifetime)",
          "0.16 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              0.92,
              0.96,
              1.0,
              1.0
            ],
            "1.00": [
              1.0,
              1.0,
              1.0,
              0.0
            ]
          }
        }
      }
    }
  }
}