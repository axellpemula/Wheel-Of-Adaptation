{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_moon_echo",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fb_moon"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.emitter_age >= 0.06 && v.emitter_age < 0.16 ? 25 : 0",
        "max_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.21000000000000002
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "2.6 + 0.6 * v.particle_age / v.particle_lifetime",
          "1.05 + 0.25 * v.particle_age / v.particle_lifetime"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1600,
          "texture_height": 160,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              160,
              160
            ],
            "step_UV": [
              160,
              0
            ],
            "max_frame": 10,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.92,
              0.96,
              1.0,
              0.7
            ],
            "0.50": [
              0.6,
              0.8,
              1.0,
              0.6
            ],
            "1.00": [
              0.4,
              0.6,
              1.0,
              0.3
            ]
          }
        }
      }
    }
  }
}
