{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_bolts",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fb_bolt"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 45,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 3.0
      },
      "minecraft:emitter_shape_disc": {
        "radius": 6.5,
        "plane_normal": "y",
        "offset": [
          0,
          2.6,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.22, 0.4)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.95 + 1.05 * v.particle_random_1",
          "2.6 + 1.4 * v.particle_random_1"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 864,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              96,
              128
            ],
            "step_UV": [
              96,
              0
            ],
            "max_frame": 9,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.40": [
              1.0,
              0.93,
              0.62,
              1.0
            ],
            "1.00": [
              1.0,
              0.8,
              0.3,
              0.8
            ]
          }
        }
      }
    }
  }
}
