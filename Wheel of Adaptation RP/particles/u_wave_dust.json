              0.82,
              0.0
            ],
            "0.15": [
              0.86,
              0.84,
              0.8,
              0.55
            ],
            "0.60": [
              0.8,
              0.78,
              0.75,
              0.35
            ],
            "1.00": [
              0.75,
              0.73,
              0.7,
              0.0
            ]
          }
        }
      }
    }
  }
