{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:quake_dust_ultra",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/fb_smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.6,
        "plane_normal": "y",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 0.95)"
      },
      "minecraft:particle_initial_speed": "math.random(5.0, 9.0)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 4.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.45 + 0.45 * v.particle_age / v.particle_lifetime) * 1.3",
          "(0.45 + 0.45 * v.particle_age / v.particle_lifetime) * 1.3"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1056,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              96,
              96
            ],
            "step_UV": [
              96,
              0
            ],
            "max_frame": 11,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.9,
              0.88,
              0.82,
              0.75
            ],
            "0.70": [
              0.8,
              0.77,
              0.72,
              0.55
            ],
            "1.00": [
              0.75,
              0.72,
              0.68,
              0.0
            ]
          }
        }
      }
    }
  }
}
