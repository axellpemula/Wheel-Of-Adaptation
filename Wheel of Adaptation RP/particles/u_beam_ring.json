{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_beam_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/adapt_ray"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 5.0,
        "plane_normal": "y",
        "surface_only": true,
        "offset": [
          0,
          6,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.4)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.6 * (1 - v.particle_age / v.particle_lifetime) * (1 - v.particle_age / v.particle_lifetime)",
          8
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              0.9
            ],
            "0.40": [
              1.0,
              0.93,
              0.62,
              0.8
            ],
            "1.00": [
              1.0,
              0.8,
              0.3,
              0.0
            ]
          }
        }
      }
    }
  }
}
