{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:blink_in",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.25)"
      },
      "minecraft:particle_initial_speed": "math.random(6.0, 10.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.6 + v.particle_age / v.particle_lifetime * 1.4",
          "0.07 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.08,
              0.07,
              0.1,
              0.9
            ],
            "0.50": [
              0.25,
              0.24,
              0.3,
              0.6
            ],
            "1.00": [
              0.4,
              0.4,
              0.45,
              0.0
            ]
          }
        }
      }
    }
  }
}