{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:dash_flash_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fb_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.dash_dir.x",
          "v.dash_dir.y",
          "v.dash_dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 0.1,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(2.1 + 0.9 * v.particle_age / v.particle_lifetime) * 1.5",
          "(1.4 + 0.6 * v.particle_age / v.particle_lifetime) * 1.5"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1536,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              192,
              128
            ],
            "step_UV": [
              192,
              0
            ],
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.60": [
              0.92,
              0.96,
              1.0,
              0.9
            ],
            "1.00": [
              0.92,
              0.96,
              1.0,
              0.5
            ]
          }
        }
      }
    }
  }
}
