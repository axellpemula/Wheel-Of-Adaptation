{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:positive_rays_ultra",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fx_ray"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 25
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.75,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.0)"
      },
      "minecraft:particle_initial_speed": 3.0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "((0.07 + 0.1 * v.particle_random_1) * (1 - 0.5 * v.particle_age / v.particle_lifetime)) * 1.3",
          "(0.5 + 3.0 * v.particle_age) * 1.3"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              0.0
            ],
            "0.15": [
              0.92,
              0.96,
              1.0,
              0.7
            ],
            "0.60": [
              0.55,
              1.0,
              0.8,
              0.45
            ],
            "1.00": [
              0.4,
              0.95,
              1.0,
              0.0
            ]
          }
        }
      }
    }
  }
}
