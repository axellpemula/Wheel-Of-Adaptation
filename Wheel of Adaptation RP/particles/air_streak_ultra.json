{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:air_streak_ultra",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.6,
        "plane_normal": [
          "v.blast_dir.x",
          "v.blast_dir.y",
          "v.blast_dir.z"
        ],
        "direction": [
          "v.blast_dir.x",
          "v.blast_dir.y",
          "v.blast_dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.1, 0.2)"
      },
      "minecraft:particle_initial_speed": "math.random(18.0, 26.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.2 + v.particle_age / v.particle_lifetime * 1.6) * 1.2",
          "(0.06 * (1 - v.particle_age / v.particle_lifetime)) * 1.2"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              0.88,
              0.96,
              1.0,
              0.85
            ],
            "0.50": [
              0.75,
              0.9,
              1.0,
              0.45
            ],
            "1.00": [
              0.7,
              0.85,
              1.0,
              0.0
            ]
          }
        }
      }
    }
  }
}
