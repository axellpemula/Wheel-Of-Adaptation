{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_ground_glint",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/adapt_glint"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1.3,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.1)"
      },
      "minecraft:particle_initial_speed": "math.random(0.8, 2.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.08 + 0.08 * v.particle_random_1) * math.sin(180 * v.particle_age / v.particle_lifetime)",
          "(0.08 + 0.08 * v.particle_random_1) * math.sin(180 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 11,
            "max_frame": 4,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "0.50": [
              1.0,
              0.93,
              0.62,
              1.0
            ],
            "1.00": [
              1.0,
              0.8,
              0.3,
              1.0
            ]
          }
        }
      }
    }
  }
}
