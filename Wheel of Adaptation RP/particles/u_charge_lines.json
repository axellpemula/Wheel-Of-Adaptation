{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:u_charge_lines",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/fx_streak"
      }
    },
