{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.xvoid.barehand_guard": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "guard": "q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'xvoid:barehand', 'xvoid:barehand_retract')"
            }
          ],
          "blend_transition": 0.15
        },
        "guard": {
          "animations": [
            "xvoid_guard",
            "xvoid_guard_walk_still"
          ],
          "transitions": [
            {
              "default": "!(q.is_using_item && q.is_item_name_any('slot.weapon.mainhand', 0, 'xvoid:barehand', 'xvoid:barehand_retract'))"
            }
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
